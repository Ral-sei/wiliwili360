 int poll(struct pollfd *fds, nfds_t nfds, int timeout)
 {
+    fd_set rfds, wfds, efds;
+    struct timeval tv, *tvp;
     nfds_t i;
     int ready = 0;
+    int any = 0;
 
     if (!fds && nfds) {
         errno = EINVAL;
         return -1;
     }
-    /* timeout==0：纯粹问"现在有没有"。Xbox 的 CRT fd 不支持非阻塞查询，
-     * 无法给出真实答案 —— 但"不阻塞地问"也不该睡。 */
+
+    /* FFmpeg 的 tcp_read() 在每次 recv() 前都调
+     * ff_network_wait_fd(POLLING_TIME=100ms) —— 下面这条旧桩"先睡满 timeout
+     * 再一律报 ready"，等于给每个 TLS record 强加 100ms。读流速度因此被钉在
+     * (单次 record 字节数)/0.1s：真机播放时反复缓冲、cache-speed 只有
+     * 26.49 KB/s，正好是一小块 record / 100ms 的量级。
+     *
+     * 这里 poll 的对象是 XNet socket，而 XNet 有 select()（curl 的整个传输
+     * 循环就跑在 select 上，是这条栈上已验证的路径），所以可读性探测是有的。
+     * 旧行为只作为 select 表达不了的集合的兜底（非 socket 的 CRT fd、超过
+     * FD_SETSIZE 项）—— FFmpeg 不会产生这两种，mpv 的 polldev 才可能。 */
+    if (nfds > FD_SETSIZE)
+        goto fallback;
+
+    FD_ZERO(&rfds);
+    FD_ZERO(&wfds);
+    FD_ZERO(&efds);
+
+    for (i = 0; i < nfds; i++) {
+        fds[i].revents = 0;
+        if (fds[i].fd < 0)
+            continue;
+        if (fds[i].events & (POLLIN | POLLRDNORM))
+            FD_SET((SOCKET)fds[i].fd, &rfds);
+        if (fds[i].events & (POLLOUT | POLLWRNORM))
+            FD_SET((SOCKET)fds[i].fd, &wfds);
+        if (fds[i].events & POLLPRI)
+            FD_SET((SOCKET)fds[i].fd, &efds);
+        any = 1;
+    }
+
+    if (!any)
+        return 0;
+
+    if (timeout < 0) {
+        tvp = NULL;                       /* 无限等待 */
+    } else {
+        tv.tv_sec  = timeout / 1000;
+        tv.tv_usec = (timeout % 1000) * 1000;
+        tvp = &tv;
+    }
+
+    if (select(0, &rfds, &wfds, &efds, tvp) == SOCKET_ERROR) {
+        /* 非 socket：保持旧桩"睡满再报 ready"，让原本能走的调用方继续走。 */
+        if (WSAGetLastError() == WSAENOTSOCK)
+            goto fallback;
+        return -1;
+    }
+
+    for (i = 0; i < nfds; i++) {
+        if (fds[i].fd < 0)
+            continue;
+        /* Winsock 的 exceptfds 同时承载 OOB 和非阻塞 connect 的失败，
+         * FFmpeg 对后者的处理是"可写/出错 -> getsockopt(SO_ERROR)"，
+         * 所以统一报 POLLERR 正是它期望的语义。 */
+        if (FD_ISSET((SOCKET)fds[i].fd, &rfds))
+            fds[i].revents |= POLLIN;
+        if (FD_ISSET((SOCKET)fds[i].fd, &wfds))
+            fds[i].revents |= POLLOUT;
+        if (FD_ISSET((SOCKET)fds[i].fd, &efds))
+            fds[i].revents |= POLLERR;
+        if (fds[i].revents)
+            ready++;
+    }
+    return ready;
+
+fallback:
+    /* 旧的桩行为：timeout==0 立即返回 0；否则睡满后把请求过的事件都报 ready。 */
     if (timeout == 0)
         return 0;
 
@@ -918,8 +987,6 @@
