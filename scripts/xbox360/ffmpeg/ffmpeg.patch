 static void customize_fd(void *ctx, int fd)
 {
     TCPContext *s = ctx;
+#if defined(_XBOX)
+    {
+        /* Xbox 360 XNet per-socket "unencrypted" opt-out — required on retail
+           consoles. The SNL defaults to secure mode; XNET_STARTUP_BYPASS_SECURITY
+           is devkit-only (retail xnet.lib silently ignores it), and even with
+           bypass an unmarked socket can appear to connect while the peer's
+           replies are silently dropped. Set ONLY 0x5801, exactly as curl's Xbox
+           transport does (third_party/curl lib/connect.c) — proven on both
+           devkit and retail. Do NOT add 0x5802 here: measured on devkit it
+           makes connect() fail immediately with WSAEHOSTUNREACH (10065) under
+           XNET_STARTUP_BYPASS_SECURITY real-IP addressing. */
+        int xnet_opt = 1;
+        setsockopt(fd, SOL_SOCKET, 0x5801, (const char*)&xnet_opt, sizeof(xnet_opt));
+    }
+#endif /* _XBOX */
     /* Set the socket's send or receive buffer sizes, if specified.
